generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(RECEPTIONIST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctor    Doctor?
  staff     Staff?
  auditLogs AuditLog[]
}

model Doctor {
  id             String        @id @default(uuid())
  userId         String        @unique
  specialization String
  phone          String?
  department     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  labRequests    LabRequest[]
  schedules DoctorSchedule[]
}

model Patient {
  id          String        @id @default(uuid())
  name        String
  email       String?       @unique
  phone       String
  gender      String?
  dateOfBirth DateTime?
  address     String?
  bloodGroup  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  bills          Bill[]
  labRequests    LabRequest[]
  dispenses      Dispense[]
  admissions     Admission[]
  documents PatientDocument[]
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  doctorId    String
  date        DateTime
  time        String
  status      AppointmentStatus @default(SCHEDULED)
  reason      String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  patient       Patient         @relation(fields: [patientId], references: [id])
  doctor        Doctor          @relation(fields: [doctorId], references: [id])
  medicalRecord MedicalRecord?
}

model MedicalRecord {
  id            String       @id @default(uuid())
  patientId     String
  appointmentId String?      @unique
  diagnosis     String?
  prescription  String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  patient       Patient      @relation(fields: [patientId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
}

model Bill {
  id          String     @id @default(uuid())
  patientId   String
  amount      Float
  description String?
  status      BillStatus @default(UNPAID)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  patient     Patient    @relation(fields: [patientId], references: [id])
  payments    Payment[]
}

model Payment {
  id     String   @id @default(uuid())
  billId String
  amount Float
  method String?
  paidAt DateTime @default(now())

  bill   Bill     @relation(fields: [billId], references: [id])
}

model LabTest {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  category    String?  //Blood, Urine, Imaging
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  labRequests LabRequest[]
}

model LabRequest {
  id          String            @id @default(uuid())
  patientId   String
  doctorId    String?
  testId      String
  status      LabRequestStatus  @default(PENDING)
  requestDate DateTime          @default(now())
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  patient     Patient           @relation(fields: [patientId], references: [id])
  doctor      Doctor?           @relation(fields: [doctorId], references: [id])
  test        LabTest           @relation(fields: [testId], references: [id])
  result      LabResult?
}

model LabResult {
  id            String   @id @default(uuid())
  labRequestId  String   @unique
  result        String
  resultDate    DateTime @default(now())
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  labRequest    LabRequest @relation(fields: [labRequestId], references: [id])
}

model Medicine {
  id            String   @id @default(uuid())
  name          String
  genericName   String?
  category      String?  //Antibiotic, Painkiller
  unit          String   //Tablet, Bottle, Syrup
  price         Float
  stockQuantity Int      @default(0)
  expiryDate    DateTime?
  manufacturer  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dispenses     Dispense[]
}

model Dispense {
  id          String   @id @default(uuid())
  medicineId  String
  patientId   String
  quantity    Int
  totalPrice  Float
  prescribedBy String? //doctor name or id
  notes       String?
  dispensedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  medicine    Medicine @relation(fields: [medicineId], references: [id])
  patient     Patient  @relation(fields: [patientId], references: [id])
}

model Ward {
  id          String   @id @default(uuid())
  name        String   //General Ward, ICU, Pediatric
  description String?
  totalBeds   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  beds        Bed[]
}

model Bed {
  id          String    @id @default(uuid())
  wardId      String
  bedNumber   String
  status      BedStatus @default(AVAILABLE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ward        Ward      @relation(fields: [wardId], references: [id])
  admissions  Admission[]
}

model Admission {
  id              String          @id @default(uuid())
  patientId       String
  bedId           String
  admittedBy      String?         //user/doctor id or name
  admissionDate   DateTime        @default(now())
  dischargeDate   DateTime?
  status          AdmissionStatus @default(ADMITTED)
  reason          String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  patient         Patient         @relation(fields: [patientId], references: [id])
  bed             Bed             @relation(fields: [bedId], references: [id])
}

model Staff {
  id            String   @id @default(uuid())
  userId        String   @unique
  employeeId    String?  @unique   
  phone         String?
  department    String?
  designation   String?  //Nurse, Lab Technician, Accountant
  joiningDate   DateTime?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  leaves      Leave[]
}

model Attendance {
  id         String   @id @default(uuid())
  staffId    String
  date       DateTime
  checkIn    String?
  checkOut   String?
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
}

model Leave {
  id         String      @id @default(uuid())
  staffId    String
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     LeaveStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  staff      Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model PatientDocument {
  id          String   @id @default(uuid())
  patientId   String
  title       String
  fileName    String
  fileUrl     String
  fileType    String?
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model DoctorSchedule {
  id         String   @id @default(uuid())
  doctorId   String
  dayOfWeek  String   // Monday, Tuesday...
  startTime  String
  endTime    String
  isAvailable Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  module     String
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  ACCOUNTANT
  NURSE
  LAB_TECHNICIAN
  PHARMACIST
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BillStatus {
  UNPAID
  PAID
  PARTIAL
}

enum LabRequestStatus {
  PENDING
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}